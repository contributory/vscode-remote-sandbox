{
  "name": "remote-sandbox",
  "displayName": "Remote Sandbox",
  "description": "Manage E2B, Daytona and Runloop sandboxes and connect to them over SSH from VS Code.",
  "version": "2.2.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/starfall-org/remote-sandbox-vscode.git"
  },
  "license": "GPL-3.0-only",
  "publisher": "starfall",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "extensionKind": [
    "ui"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "remote-sandbox",
          "title": "Remote Sandbox",
          "icon": "$(cloud)"
        }
      ]
    },
    "views": {
      "remote-sandbox": [
        {
          "id": "remote-sandbox-sandboxes-sidebar",
          "name": "Sandboxes",
          "type": "tree",
          "when": "true",
          "icon": "$(server)"
        }
      ]
    },
    "commands": [
      {
        "command": "remote-sandbox.refreshSandboxes",
        "title": "Refresh Sandboxes",
        "icon": "$(refresh)"
      },
      {
        "command": "remote-sandbox.e2bPauseSandbox",
        "title": "E2B: Pause Sandbox",
        "icon": "$(debug-pause)"
      },
      {
        "command": "remote-sandbox.e2bResumeSandbox",
        "title": "E2B: Resume Sandbox",
        "icon": "$(debug-start)"
      },
      {
        "command": "remote-sandbox.e2bListSandboxes",
        "title": "E2B: List Sandboxes"
      },
      {
        "command": "remote-sandbox.daytonaStopSandbox",
        "title": "Daytona: Stop Sandbox",
        "icon": "$(debug-stop)"
      },
      {
        "command": "remote-sandbox.daytonaStartSandbox",
        "title": "Daytona: Start Sandbox",
        "icon": "$(debug-start)"
      },
      {
        "command": "remote-sandbox.daytonaListSandboxes",
        "title": "Daytona: List Sandboxes"
      },
      {
        "command": "remote-sandbox.runloopCreateDevbox",
        "title": "Runloop: Create Devbox",
        "icon": "$(add)"
      },
      {
        "command": "remote-sandbox.runloopSuspendDevbox",
        "title": "Runloop: Suspend Devbox",
        "icon": "$(debug-pause)"
      },
      {
        "command": "remote-sandbox.runloopResumeDevbox",
        "title": "Runloop: Resume Devbox",
        "icon": "$(debug-start)"
      },
      {
        "command": "remote-sandbox.runloopShutdownDevbox",
        "title": "Runloop: Shut Down Devbox",
        "icon": "$(debug-stop)"
      },
      {
        "command": "remote-sandbox.runloopSnapshotDevbox",
        "title": "Runloop: Snapshot Devbox Disk",
        "icon": "$(camera)"
      },
      {
        "command": "remote-sandbox.runloopListDevboxes",
        "title": "Runloop: List Devboxes"
      },
      {
        "command": "remote-sandbox.runloopListSnapshots",
        "title": "Runloop: List Snapshots"
      },
      {
        "command": "remote-sandbox.runloopSetApiKey",
        "title": "Runloop: Set API Key"
      },
      {
        "command": "remote-sandbox.e2bSetApiKey",
        "title": "E2B: Set API Key"
      },
      {
        "command": "remote-sandbox.e2bCreateSandbox",
        "title": "E2B: Create Sandbox",
        "icon": "$(add)"
      },
      {
        "command": "remote-sandbox.e2bDeleteSandbox",
        "title": "E2B: Delete Sandbox",
        "icon": "$(trash)"
      },
      {
        "command": "remote-sandbox.daytonaSetApiKey",
        "title": "Daytona: Set API Key"
      },
      {
        "command": "remote-sandbox.daytonaCreateSandbox",
        "title": "Daytona: Create Sandbox",
        "icon": "$(add)"
      },
      {
        "command": "remote-sandbox.daytonaDeleteSandbox",
        "title": "Daytona: Delete Sandbox",
        "icon": "$(trash)"
      },
      {
        "command": "remote-sandbox.freestyleSetApiKey",
        "title": "Freestyle: Set API Key"
      },
      {
        "command": "remote-sandbox.freestyleCreateVm",
        "title": "Freestyle: Create VM",
        "icon": "$(add)"
      },
      {
        "command": "remote-sandbox.freestyleSuspendVm",
        "title": "Freestyle: Suspend VM",
        "icon": "$(debug-pause)"
      },
      {
        "command": "remote-sandbox.freestyleStartVm",
        "title": "Freestyle: Start VM",
        "icon": "$(debug-start)"
      },
      {
        "command": "remote-sandbox.freestyleResumeVm",
        "title": "Freestyle: Resume VM",
        "icon": "$(debug-start)"
      },
      {
        "command": "remote-sandbox.freestyleDeleteVm",
        "title": "Freestyle: Delete VM",
        "icon": "$(trash)"
      },
      {
        "command": "remote-sandbox.freestyleListVms",
        "title": "Freestyle: List VMs"
      },
      {
        "command": "remote-sandbox.connectInCurrentWindow",
        "title": "Connect in Current Window",
        "icon": "$(arrow-right)"
      },
      {
        "command": "remote-sandbox.connectInNewWindow",
        "title": "Connect in New Window",
        "icon": "$(empty-window)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "remote-sandbox.refreshSandboxes",
          "when": "view == remote-sandbox-sandboxes-sidebar",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "remote-sandbox.e2bCreateSandbox",
          "when": "viewItem == e2bSection && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.daytonaCreateSandbox",
          "when": "viewItem == daytonaSection && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.runloopCreateDevbox",
          "when": "viewItem == runloopSection && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@1"
        },
        {
          "command": "remote-sandbox.runloopListSnapshots",
          "when": "viewItem == runloopSection && view == remote-sandbox-sandboxes-sidebar",
          "group": "1_snapshots@1"
        },
        {
          "command": "remote-sandbox.freestyleCreateVm",
          "when": "viewItem == freestyleSection && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.e2bPauseSandbox",
          "when": "viewItem == e2bSandboxRunning && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.e2bResumeSandbox",
          "when": "viewItem == e2bSandboxPaused && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.connectInCurrentWindow",
          "when": "viewItem =~ /e2bSandbox/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@1"
        },
        {
          "command": "remote-sandbox.connectInNewWindow",
          "when": "viewItem =~ /e2bSandbox/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@2"
        },
        {
          "command": "remote-sandbox.e2bDeleteSandbox",
          "when": "viewItem =~ /e2bSandbox/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "3_delete@1"
        },
        {
          "command": "remote-sandbox.daytonaStopSandbox",
          "when": "viewItem == daytonaSandboxStarted && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.daytonaStartSandbox",
          "when": "viewItem == daytonaSandboxStopped && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.connectInCurrentWindow",
          "when": "viewItem =~ /daytonaSandbox/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@1"
        },
        {
          "command": "remote-sandbox.connectInNewWindow",
          "when": "viewItem =~ /daytonaSandbox/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@2"
        },
        {
          "command": "remote-sandbox.daytonaDeleteSandbox",
          "when": "viewItem =~ /daytonaSandbox/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "3_delete@1"
        },
        {
          "command": "remote-sandbox.freestyleSuspendVm",
          "when": "viewItem == freestyleVmRunning && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.freestyleStartVm",
          "when": "viewItem == freestyleVmStopped && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.freestyleResumeVm",
          "when": "viewItem == freestyleVmSuspended && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.connectInCurrentWindow",
          "when": "viewItem =~ /freestyleVm/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@1"
        },
        {
          "command": "remote-sandbox.connectInNewWindow",
          "when": "viewItem =~ /freestyleVm/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@2"
        },
        {
          "command": "remote-sandbox.freestyleDeleteVm",
          "when": "viewItem =~ /freestyleVm/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "3_delete@1"
        },
        {
          "command": "remote-sandbox.runloopSuspendDevbox",
          "when": "viewItem == runloopDevboxRunning && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.runloopResumeDevbox",
          "when": "viewItem == runloopDevboxSuspended && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-sandbox.connectInCurrentWindow",
          "when": "viewItem =~ /runloopDevbox/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@1"
        },
        {
          "command": "remote-sandbox.connectInNewWindow",
          "when": "viewItem =~ /runloopDevbox/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "inline@2"
        },
        {
          "command": "remote-sandbox.runloopShutdownDevbox",
          "when": "viewItem =~ /runloopDevbox/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "3_delete@1"
        },
        {
          "command": "remote-sandbox.runloopSnapshotDevbox",
          "when": "viewItem =~ /runloopDevbox/ && view == remote-sandbox-sandboxes-sidebar",
          "group": "4_snapshot@1"
        }
      ]
    },
    "configuration": {
      "title": "Remote Sandbox",
      "properties": {
        "remoteSandbox.e2bApiKey": {
          "type": "string",
          "default": "",
          "editPresentation": "password",
          "markdownDescription": "Your [E2B](https://e2b.dev) API key. The extension uses this to authenticate with the E2B API. Set it here, run the **E2B: Set API Key** command, or use the `E2B_API_KEY` environment variable."
        },
        "remoteSandbox.daytonaApiKey": {
          "type": "string",
          "default": "",
          "editPresentation": "password",
          "markdownDescription": "Your [Daytona](https://www.daytona.io) API key. The extension uses this to authenticate with the Daytona API. Set it here, run the **Daytona: Set API Key** command, or use the `DAYTONA_API_KEY` environment variable."
        },
        "remoteSandbox.daytonaApiUrl": {
          "type": "string",
          "default": "https://app.daytona.io/api",
          "description": "Base URL of the Daytona API. Change this only when targeting a self-hosted Daytona deployment."
        },
        "remoteSandbox.daytonaSshExpiresInMinutes": {
          "type": "number",
          "default": 60,
          "description": "Expiration time (in minutes) for the generated Daytona SSH access token."
        },
        "remoteSandbox.runloopApiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Your [Runloop](https://runloop.ai) API key. The extension uses this to authenticate with the Runloop API. Set it here, run the **Runloop: Set API Key** command, or use the `RUNLOOP_API_KEY` environment variable.",
          "editPresentation": "password"
        },
        "remoteSandbox.freestyleApiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Your [Freestyle](https://freestyle.sh) API key. The extension uses this to authenticate with the Freestyle API. Set it here, run the **Freestyle: Set API Key** command, or use the `FREESTYLE_API_KEY` environment variable.",
          "editPresentation": "password"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.3"
  }
}